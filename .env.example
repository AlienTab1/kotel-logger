# Compose načítá cesty, nikoliv obsah hesel. Nahraďte placeholdery.
KOTEL_DATA_DIR=/ABSOLUTNI/CESTA/K/DATASETU/kotel-reader
THEMATRONIC_USERNAME_SECRET=./secrets/thematronic_username
THEMATRONIC_PASSWORD_SECRET=./secrets/thematronic_password
MQTT_PASSWORD_SECRET=./secrets/mqtt_password
# Skutečná LAN IP NASu a předem ověřený volný port pro Prometheus:
KOTEL_METRICS_BIND_IP=DOPLNTE_LAN_IP_NASU
KOTEL_METRICS_PORT=9108
# Jen pro compose.macvlan.yaml: předem ověřená volná IP
# KOTEL_LAN_IP=DOPLNTE_VOLNOU_IP
