{
  "uid": "kotelna-prometheus",
  "title": "Kotelna — Prometheus",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "tags": [
    "kotelna",
    "prometheus"
  ],
  "description": "Prometheus scrape history. Missing samples are not backfilled. Reception time is not measurement time. Lines do not connect nulls; long ranges may hide short gaps.",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(kotel_build_info, job)",
        "refresh": 1,
        "current": {
          "text": "kotel-logger",
          "value": "kotel-logger"
        }
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(kotel_build_info{job=~\"$job\"}, instance)",
        "refresh": 1
      },
      {
        "name": "device_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(kotel_build_info{job=~\"$job\",instance=~\"$instance\"}, device_id)",
        "refresh": 1,
        "current": {
          "text": "2985",
          "value": "2985"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Boiler and flue temperatures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_temperature_celsius{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\",signal=~\"s_t_spal|s_t_ko_vy|s_t_ko_vr\"}",
          "legendFormat": "{{signal}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Thermal storage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_temperature_celsius{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\",signal=~\"s_t_akuh|s_t_akus|s_t_akud\"}",
          "legendFormat": "{{signal}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Heating zones and outdoor",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_temperature_celsius{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\",signal=~\"s_t_zo1_vy|s_t_zo2_vy|s_t_venku\"}",
          "legendFormat": "{{signal}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Reception age (not measurement age)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_receive_age_seconds{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"}",
          "legendFormat": "Age",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Last received response",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_last_received_timestamp_seconds{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"} * 1000",
          "legendFormat": "Received",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          },
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Availability",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "up{job=~\"$job\",instance=~\"$instance\"}",
          "legendFormat": "Scrape reachable",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_collector_healthy{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"}",
          "legendFormat": "Scheduler healthy",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_telemetry_available{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"}",
          "legendFormat": "Web data available",
          "range": true,
          "instant": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_mqtt_connected{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"}",
          "legendFormat": "MQTT connected",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Raw boolean states — verify meaning and polarity",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_signal_state{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"}",
          "legendFormat": "{{signal}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Session state",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_session_state{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"} == 1",
          "legendFormat": "{{state}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "HTTP and session events per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(kotel_http_errors_total{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"}[$__rate_interval])",
          "legendFormat": "HTTP errors",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(kotel_login_attempts_total{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"}[$__rate_interval])",
          "legendFormat": "Login attempts",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(kotel_session_losses_total{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"}[$__rate_interval])",
          "legendFormat": "Session losses",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Signal availability",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_signal_available{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"}",
          "legendFormat": "{{signal}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Room temperatures and zone water targets",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_temperature_celsius{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\",signal=~\"dev_prost_z[12]|s_t_zo[12]_voda_poz\"}",
          "legendFormat": "{{signal}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Additional temperatures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_temperature_celsius{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\",signal=~\"s_t_nezamrz|s_t_blokace|s_t_solar|s_t_aku2.*\"}",
          "legendFormat": "{{signal}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Source maxima — period unverified",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_maximum_temperature_celsius{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\"}",
          "legendFormat": "{{signal}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "Raw operating codes — meaning requires verification",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 50,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kotel_signal_value{job=~\"$job\",instance=~\"$instance\",device_id=~\"$device_id\",signal=~\"dev_rezim_z[12]|dev_set_z[12]\"}",
          "legendFormat": "{{signal}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
