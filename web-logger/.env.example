# Compose reads file paths, not password contents. Replace the placeholders.
KOTEL_DATA_DIR=/ABSOLUTE/PATH/TO/DATASET/kotel-reader
THEMATRONIC_USERNAME_SECRET=./secrets/thematronic_username
THEMATRONIC_PASSWORD_SECRET=./secrets/thematronic_password
MQTT_PASSWORD_SECRET=./secrets/mqtt_password
# Actual NAS LAN IP and a verified available port for Prometheus:
KOTEL_METRICS_BIND_IP=REPLACE_NAS_LAN_IP
KOTEL_METRICS_PORT=9108
# Only for compose.macvlan.yaml: a verified available IP address
# KOTEL_LAN_IP=REPLACE_AVAILABLE_IP
